NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-03-01

# Sanity API Write Token (Optional for write mutations & asset uploads from Next.js API routes)
# Create a token with 'Editor' permissions in Sanity Manage -> API -> Tokens
